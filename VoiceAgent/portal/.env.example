# Copy to .env in this directory and configure your own allowlisted Azure
# Foundry project. The portal cannot start without a valid project endpoint.
AZURE_VOICE_AGENTS_ENDPOINT=
AZURE_CREDENTIAL_MODE=default
AZURE_VOICE_AGENTS_MODEL=gpt-realtime
AZURE_VOICE_AGENTS_VOICE=en-US-AvaNeural

# Optional: your deployment names, not managed model names (comma-separated).
VOICE_PORTAL_REALTIME_DEPLOYMENTS=
VOICE_PORTAL_CASCADED_DEPLOYMENTS=

# Optional: user-owned project connections. No bundled connections or credentials.
AZURE_VOICE_AGENTS_MCP_CONNECTION_ID=
AZURE_VOICE_AGENTS_MCP_SERVER_LABEL=mcp
AZURE_VOICE_AGENTS_FOUNDRY_IQ_URL=
AZURE_VOICE_AGENTS_FOUNDRY_IQ_CONNECTION_ID=
AZURE_VOICE_AGENTS_TOOLBOX_NAME=
AZURE_VOICE_AGENTS_TOOLBOX_VERSION=

# Optional: enable the Foundry traces link without automatic ARM discovery.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Local-only server; no authentication for remote hosting is provided.
VOICE_PORTAL_HOST=127.0.0.1
DEMO_PORT=9527
VOICE_PORTAL_DATA_DIR=~/.voice-agent-portal
VOICE_PORTAL_RECORD_SESSIONS=true

# Optional. Paths inside this JSON file are resolved relative to the file.
VOICE_PORTAL_TEMPLATE_CONFIG=templates.config.json
