# Required for every sample.
AZURE_VOICE_AGENTS_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_VOICE_AGENTS_MODEL=gpt-realtime

# Optional common settings.
AZURE_VOICE_AGENTS_MODEL_TYPE=managed
AZURE_VOICE_AGENTS_VOICE=en-US-Ava:DragonHDLatestNeural
AZURE_VOICE_AGENTS_OUTPUT_DIR=voice-agent-output
# Optional: all agent samples use this existing agent instead of creating one.
AZURE_VOICE_AGENTS_AGENT_NAME=

# Required for download_conversation_traces.py.
AZURE_VOICE_AGENTS_APP_INSIGHTS_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Insights/components/<app-insights-name>

# Required only for the MCP microphone lifecycle.
AZURE_VOICE_AGENTS_MCP_CONNECTION_ID=
AZURE_VOICE_AGENTS_MCP_SERVER_LABEL=my-mcp-server

# Required only for the Foundry IQ microphone lifecycle.
AZURE_VOICE_AGENTS_FOUNDRY_IQ_URL=
AZURE_VOICE_AGENTS_FOUNDRY_IQ_CONNECTION_ID=

# Required only for the Foundry Toolbox microphone lifecycle.
AZURE_VOICE_AGENTS_TOOLBOX_NAME=voice-agent-toolbox-azure-search
AZURE_VOICE_AGENTS_TOOLBOX_VERSION=1
