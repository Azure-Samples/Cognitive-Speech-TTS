# Existing Foundry project with the Voice Agents / GPT Live preview enabled.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Optional existing GPT Live agent. Leave blank to create a new English teacher.
AGENT_NAME=

# Sign in with az login. No API keys or manually copied tokens are needed.
# Optional: choose a signed-in subscription without changing the CLI default.
AZURE_SUBSCRIPTION_ID=

# Required only when AGENT_NAME is blank; existing agents use their saved settings.
GPT_LIVE_DEPLOYMENT=YOUR-GPT-LIVE-DEPLOYMENT
# Responses backend used for delegation.
GPT_LIVE_DELEGATION_DEPLOYMENT=YOUR-DELEGATION-DEPLOYMENT
