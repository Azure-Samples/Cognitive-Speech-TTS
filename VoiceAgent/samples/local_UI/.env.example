AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_CREDENTIAL_MODE=default

# Keep the token-handling UI on loopback. VS Code Remote-SSH can forward it.
LOCAL_UI_HOST=127.0.0.1
LOCAL_UI_PORT=8097
LOCAL_UI_DATA_DIR=~/.voice-agent-local-ui

# Optional. Paths inside this JSON file are resolved relative to the file.
LOCAL_UI_TEMPLATE_CONFIG=templates.config.json

# Optional one-click template credentials. Distribute scoped trial tokens
# out-of-band; never commit real values. If blank, the Templates UI asks once.
VOICE_AGENT_TEMPLATE_FINANCE_EXAMPLE_MCP_TOKEN=
VOICE_AGENT_TEMPLATE_FINANCE_OTP_OFFICER_SEARCH_MCP_TOKEN=
