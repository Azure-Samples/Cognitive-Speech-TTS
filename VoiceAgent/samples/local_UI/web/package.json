{
  "name": "voice-agent-local-ui-web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Local playground for published Microsoft Foundry Voice Agents.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --jsx=automatic --loader:.jsx=jsx --outfile=../static/dashboard-bundle.js",
    "test": "node --test src/lib/*.test.mjs",
    "watch": "esbuild src/main.jsx --bundle --sourcemap --format=iife --jsx=automatic --loader:.jsx=jsx --outfile=../static/dashboard-bundle.js --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
