{
  "name": "voice-agent-local-ui-web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Voice Agent studio and standalone WebRTC demo.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --jsx=automatic --loader:.jsx=jsx --outfile=../static/dashboard-bundle.js",
    "test": "node --test src/lib/*.test.mjs",
    "test:ui": "npm run build && playwright test",
    "watch": "esbuild src/main.jsx --bundle --sourcemap --format=iife --jsx=automatic --loader:.jsx=jsx --outfile=../static/bundle.js --watch",
    "watch:webrtc": "esbuild src/webrtc/main.jsx --bundle --sourcemap --format=iife --jsx=automatic --loader:.jsx=jsx --outfile=../static/webrtc-bundle.js --watch"
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
