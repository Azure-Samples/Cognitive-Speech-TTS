# Replace every angle-bracketed value before running locally.
AZURE_VOICELIVE_ENDPOINT=https://<voice-live-account>.services.ai.azure.com/
AZURE_VOICELIVE_MODEL=<realtime-model-deployment>
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
KNOWLEDGE_BASE_NAME=<knowledge-base-name>

# Optional: use a different JSON corpus when provisioning the knowledge base.
# KNOWLEDGE_DOCUMENTS_PATH=<path-to-documents.json>

# Optional direct endpoint instead of constructing it from the two Search values.
# KB_MCP_ENDPOINT=https://<search-service>.search.windows.net/knowledgebases/<knowledge-base-name>/mcp?api-version=2026-08-01-preview

# Optional standard voice override.
# AZURE_VOICELIVE_VOICE=<standard-voice-name>

# One greeting per new connection. Customize the text or set an empty value to disable.
AZURE_VOICELIVE_GREETING="Hello! I'm your AI knowledge assistant. How can I help you today?"
# AZURE_VOICELIVE_GREETING=""

# Experimental built-in Avatar; disabled by default.
AZURE_VOICELIVE_ENABLE_AVATAR=false
